{
    admin unix//run/vidfetch-caddy/admin.sock
    auto_https off
}
http://vidfetch.app, http://www.vidfetch.app {
    header {
        X-Robots-Tag "noindex, nofollow"
        Cache-Control "no-store"
        -Server
    }
    @probe path /.well-known/acme-challenge/vidfetch-phase5-reachability
    handle @probe {
        respond "vidfetch-phase5-origin-reachable" 200
    }
    handle {
        redir https://vidfetch.app{uri} 308
    }
}
