[Unit]
Description=VidFetch Next.js frontend (loopback)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vidfetch-web
Group=vidfetch-web
WorkingDirectory=/opt/vidfetch-web/current/app
EnvironmentFile=/etc/vidfetch/web.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/vidfetch/tools/node-v22.23.3-linux-x64/bin/node --max-old-space-size=256 /opt/vidfetch-web/current/app/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StateDirectory=vidfetch-web
StateDirectoryMode=0700
CacheDirectory=vidfetch-web
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0
CPUAccounting=true
CPUQuota=100%
TasksMax=96
LimitNOFILE=2048
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
