# Prepared only: install and activate after explicit public-network approval.
[Unit]
Description=VidFetch Cloudflare-only HTTP(S) ingress guard
Before=vidfetch-caddy.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/bin/python3 /usr/local/libexec/vidfetch-web-ingress
# Deliberately no ExecStop deleting the guard or modifying other nft tables.
User=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_NETLINK

[Install]
WantedBy=multi-user.target
