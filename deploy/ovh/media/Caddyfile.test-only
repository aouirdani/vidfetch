# Phase 8 candidate ONLY. Not installed. Frontend Basic Auth and test noindex retained.
{
    admin unix//run/vidfetch-caddy/admin.sock
    servers {
        protocols h1 h2
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
        max_header_size 16KB
        timeouts {
            read_header 10s
            read_body 15s
            idle 5m
        }
    }
    # No access logger: queries contain media URLs and one-use tickets.
    log default {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete ticket
                    delete status
                    delete token
                    delete url
                    delete text
                    delete link
                    delete u
                }
                request>headers>Authorization delete
                request>headers>Cookie delete
                request>headers>X-Vidfetch-Proof delete
            }
        }
    }
}

(test_headers) {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Robots-Tag "noindex, nofollow"
        Cache-Control "private, no-store, max-age=0"
        -Server
        defer
    }
}
(http01) {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            disable_tlsalpn_challenge
        }
    }
}
vidfetch.app {
    import http01
    import test_headers
    handle_errors {
        import test_headers
        respond "{err.status_text}" {err.status_code}
    }
    @outsideCloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    respond @outsideCloudflare 403
    @private path /auth/admission /auth/deployment /internal/* /sitemap.xml /sitemap* /server-status
    handle @private {
        respond 404
    }
    @robots path /robots.txt
    handle @robots {
        header Content-Type text/plain
        respond "User-agent: *
Disallow: /
" 200
    }
    @media path /api/fetch-info /api/download /api/queue /auth/transfer /download-helper
    handle @media {
        header Content-Type application/json
        respond `{"ok":false,"code":"BACKEND_UNAVAILABLE","error":"Downloads are unavailable during this private test."}` 503
    }
    handle {
        route {
            import /etc/vidfetch/public-https-test/auth.caddy
            request_body {
                max_size 32KB
            }
            encode zstd gzip
            reverse_proxy 127.0.0.1:3001 {
                header_up Host vidfetch.app
                header_up X-Forwarded-Proto https
                header_up X-Forwarded-For {client_ip}
                header_up -Authorization
                header_up -Proxy-Authorization
                header_up -CF-Connecting-IP
                header_up -X-Real-IP
                transport http {
                    dial_timeout 3s
                    response_header_timeout 30s
                }
            }
        }
    }
}
www.vidfetch.app {
    import http01
    import test_headers
    redir https://vidfetch.app{uri} 301
}

# Requires manual DNS-only record, public certificate and reviewed ingress rules.
# Reserved documentation IP default DENIES every real visitor until testers set.
dl.vidfetch.app {
    import http01
    import test_headers
    header Referrer-Policy no-referrer
    @notTester not remote_ip {$VIDFETCH_MEDIA_TEST_IPS:192.0.2.1/32}
    respond @notTester 403
    @download path /api/fetch-info /api/download /api/queue /auth/transfer /download-helper
    handle @download {
        request_body {
            max_size 8KB
        }
        reverse_proxy 127.0.0.1:8789 {
            header_up Host dl.vidfetch.app
            header_up X-Forwarded-Proto https
            # Direct peer only: no trust in client-supplied CF or forwarding headers.
            header_up X-Forwarded-For {remote_host}
            header_up -Proxy-Authorization
            header_up -CF-Connecting-IP
            header_up -X-Real-IP
            transport http {
                dial_timeout 3s
                response_header_timeout 240s
            }
        }
    }
    handle {
        respond 404
    }
}
