# VidFetch — English UI, Node/Express + React, PostgreSQL, yt-dlp and ffmpeg.
# Copy to .env. Never commit session cookies or production secrets.
NODE_ENV=development
# Explicit local Node hosting. Omit this opt-in on Vercel.
VIDFETCH_TARGET=node
PORT=5000
CORS_ORIGIN=https://vidfetch.io
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional explicit binaries. Leave empty for automatic resolution.
# Next builds install a verified standalone yt-dlp build in .media-bin/.
# Docker installs yt-dlp[default,curl-cffi] in /opt/vidfetch and system ffmpeg.
YTDLP_PATH=
FFMPEG_PATH=
MAX_PARALLEL_DOWNLOADS=4

# Optional Netscape-format cookie files mounted as SERVER-SIDE secrets.
# Only configure authorized sessions for content you have permission to access.
# A per-platform file takes precedence over the shared file. Never use NEXT_PUBLIC_.
YTDLP_COOKIES_FILE=
YTDLP_INSTAGRAM_COOKIES=
YTDLP_TIKTOK_COOKIES=

# Optional server operator's outbound HTTP/SOCKS proxy.
YTDLP_PROXY=

# Set to 1 only if the deployment already provisions yt-dlp with curl_cffi support.
VIDFETCH_SKIP_ENGINE_SETUP=0
NEXT_PUBLIC_SITE_URL=https://vidfetch.io

# Docker Compose only: set a generated, URL-safe password before deployment.
# The local Next.js preview uses DATABASE_URL above instead.
POSTGRES_USER=vidfetch
POSTGRES_DB=vidfetch
POSTGRES_PASSWORD=
