# Apply ONLY inside the dedicated namespace, after replacing PROXY_UID.
# This table does not alter host/SSH/8787 rules. Test before any public exposure.
table inet vidfetch_egress {
    set denied4 {
        type ipv4_addr; flags interval;
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
          169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
          192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
          198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }
    }
    chain output {
        type filter hook output priority 0; policy drop;
        ct state established,related accept
        meta skuid PROXY_UID ip daddr 127.0.0.1 tcp dport 8788 accept
        ip daddr @denied4 drop
        # IPv6 disabled for worker egress until a tested public IPv6 policy exists.
        meta nfproto ipv6 drop
        ip daddr 1.1.1.1 udp dport 53 accept
        ip daddr 1.1.1.1 tcp dport 53 accept
        tcp dport { 80, 443 } accept
    }
    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iifname "lo" tcp dport 8788 accept
    }
}
