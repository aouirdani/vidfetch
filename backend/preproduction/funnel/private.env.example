# TEMPLATE ONLY. Store the real file privately; never put its secrets in Git.
# The selected hostname must be the actual stable device hostname in your tailnet.
VIDFETCH_GATEWAY_ENABLED=0
VIDFETCH_PROXY=funnel
VIDFETCH_PI_MODE=1
VIDFETCH_GATEWAY_ORIGIN=https://vidfetch.YOUR-TAILNET.ts.net
VIDFETCH_SITE_ORIGINS=https://YOUR-STABLE-PREVIEW.vercel.app
VIDFETCH_PRIVATE_BACKEND=http://127.0.0.1:8788
VIDFETCH_QUOTA_DB=/var/lib/vidfetch-gateway/quota.sqlite
VIDFETCH_ACCESS_SIGNING_KEY=SET-PRIVATELY-FROM-SECRET-MANAGER
VIDFETCH_QUEUE_ENABLED=1
VIDFETCH_QUEUE_MAX=2
VIDFETCH_QUEUE_WAIT_SECONDS=180
VIDFETCH_QUEUE_ESTIMATE_SECONDS=90
VIDFETCH_PUBLIC_MAX_MIB=16
VIDFETCH_STREAM_KIBPS=64
# API authentication, isolation, HMAC and public exposure are separate controls.
