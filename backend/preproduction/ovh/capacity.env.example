# Gateway and engine capacity settings. Copy selected values into the existing root-owned
# service environment files only through a reviewed admin procedure. Defaults preserve today's policy.
VIDFETCH_PUBLIC_MAX_MIB=256
VIDFETCH_PUBLIC_MAX_MINUTES=30
VIDFETCH_PUBLIC_MAX_OPERATION_MINUTES=10
VIDFETCH_PUBLIC_MAX_CONCURRENT=1
VIDFETCH_QUEUE_ENABLED=1
VIDFETCH_QUEUE_MAX=8
VIDFETCH_QUEUE_WAIT_SECONDS=300
VIDFETCH_QUEUE_ESTIMATE_SECONDS=90
VIDFETCH_STREAM_KIBPS=2048
VIDFETCH_QUOTA_IDENTITY_OPS_DAY=8
VIDFETCH_QUOTA_GLOBAL_OPS_DAY=100
VIDFETCH_QUOTA_IDENTITY_MIB_DAY=1024
VIDFETCH_QUOTA_GLOBAL_MIB_DAY=4096
VIDFETCH_RATE_REQUESTS_MIN=120
VIDFETCH_RATE_WORK_10MIN=20
VIDFETCH_RATE_GRANTS_MIN=10
# Optional HTTPS webhook; never put the real URL/token in this example or in Git.
# VIDFETCH_CAPACITY_ALERT_WEBHOOK=
