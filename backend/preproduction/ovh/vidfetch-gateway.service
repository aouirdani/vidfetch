[Unit]
Description=VidFetch authenticated admission and streaming gateway (loopback only)
After=vidfetch.service
Requires=vidfetch.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=vidfetch-gateway
Group=vidfetch-gateway
WorkingDirectory=/var/lib/vidfetch-gateway
EnvironmentFile=/etc/vidfetch/gateway.env
ExecStart=/opt/vidfetch/tools/node-v22.23.3-linux-x64/bin/node --max-old-space-size=96 /opt/vidfetch/releases/ovh-20261012-rnllrb69-ipv4/vidfetch-gateway.cjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
StateDirectory=vidfetch-gateway
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryAccounting=true
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
CPUAccounting=true
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
